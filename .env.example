# commspt-bot 配置示例
#
# 复制为 .env（或 .env.prod / .env.dev）后填入实际值。
# 说明：
#   - 简单类型（字符串 / 数字 / 布尔）直接写值
#   - 列表与对象类型使用 JSON 书写（如 ADMIN_LIST=[10001,10002]）
#   - 嵌套配置使用双下划线 `__` 分隔（如 DEFINED_QQ__LITTLESKIN_MAIN）

# ==== NoneBot 基础 ====
# 驱动：fastapi + httpx + websockets（反向 WS、HTTP API 均可用）
DRIVER=~fastapi+~httpx+~websockets
# 反向 WebSocket 监听地址（配合 OneBot 实现使用）
HOST=0.0.0.0
PORT=8080
# 超级用户（拥有全部权限，逗号分隔）
SUPERUSERS=[]

# ==== 机器人自身 ====
# 命令前缀
COMMAND_PROMPT=&

# ==== 群号配置 ====
DEFINED_QQ__FORWARD_BOT=123456789
DEFINED_QQ__LITTLESKIN_MAIN=123456789
DEFINED_QQ__LITTLESKIN_CAFE=123456789
DEFINED_QQ__COMMSPT_GROUP=123456789
DEFINED_QQ__CSL_GROUP=123456789
DEFINED_QQ__NOTIFICATION_CHANNEL=123456789
DEFINED_QQ__DEV_GROUP=123456789

# ==== 外部 API ====
# 皮肤渲染服务（SkinRenderMC）
API_SKINRENDERMC__ENDPOINT=https://skinrender.example.com
# 旧版渲染服务（预留）
API_MIHARI_SVG__ENDPOINT=https://mihari-svg.example.com
# 皮肤站主站地址（用于直连 Yggdrasil / CSL）
API_LITTLESKIN_ORIGIN__ENDPOINT=https://littleskin.cn
# IP 归属地查询服务
API_BINGLING_IPIP__ENDPOINT=https://ipip.example.com
# 无头浏览器截图服务（browserless）
API_BROWSERLESS__ENDPOINT=https://browserless.example.com
# 云控配置服务（JSON；用于自动放人 / 临时入群欢迎语）
API_CLOUDCONFIG={"endpoint": "https://cloudconfig.example.com", "username": "user", "password": "pass"}

# ==== 数据库 ====
DB_MONGO__URL=mongodb://127.0.0.1:27017

# ==== 权限与密钥 ====
# 管理员 QQ 号列表（可执行 %mute / %check / do 等命令）
ADMIN_LIST=[10001,10002]
# LittleSkin Admin API Token（用于查询用户 UID / 邮箱）
LITTLESKIN_ADMIN_TOKEN=eyJhbGciOi...

# ==== 其他 ====
# 开发模式（当前未使用）
DEV_MODE=false
