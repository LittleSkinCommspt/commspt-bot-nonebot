# commspt-bot 配置示例

# ==== NoneBot 基础 ====
# 驱动：fastapi + httpx + websockets（反向 WS、HTTP API 均可用）
DRIVER=~fastapi+~httpx+~websockets
# WebSocket 服务器监听地址
HOST=0.0.0.0
PORT=8080
# WebSocket 客户端连接
# ONEBOT_WS_URLS=["ws://127.0.0.1:6700"]
# ONEBOT_ACCESS_TOKEN=你的访问令牌

# ==== 机器人自身 ====
# 命令前缀，静态问答命令（&help / &faq / &pay 等）的触发前缀跟随此配置
COMMAND_START=["&"]
# 是否将 COMMAND_START 作为 Alconna 全局命令前缀
# 注意：nonebot_plugin_alconna 库的默认值为 false，此处必须设为 true，
# 否则配置的前缀不会应用到 Alconna 命令（含静态问答分发器的前缀识别）
ALCONNA_USE_COMMAND_START=true

# ==== 群号配置 ====
DEFINED_QQ__FORWARD_BOT=123456789
DEFINED_QQ__LITTLESKIN_MAIN=123456789
DEFINED_QQ__LITTLESKIN_CAFE=123456789
DEFINED_QQ__COMMSPT_GROUP=123456789
DEFINED_QQ__CSL_GROUP=123456789
DEFINED_QQ__NOTIFICATION_CHANNEL=123456789
DEFINED_QQ__DEV_GROUP=123456789

# ==== 外部 API ====
# 皮肤渲染服务（SkinRenderMC）
API_SKINRENDERMC__ENDPOINT=https://skinrender.example.com
# 旧版渲染服务（预留）
API_MIHARI_SVG__ENDPOINT=https://mihari-svg.example.com
# 皮肤站主站地址（用于直连 Yggdrasil / CSL）
API_LITTLESKIN_ORIGIN__ENDPOINT=https://example.com
# IP 归属地查询服务
API_BINGLING_IPIP__ENDPOINT=https://ipip.example.com
# 无头浏览器截图服务（browserless）
API_BROWSERLESS__ENDPOINT=https://browserless.example.com
# 无头浏览器渲染模式：REMOTE=调用上方远程 Browserless 服务；LOCAL=使用本地 Playwright 渲染
# LOCAL 需安装可选依赖与浏览器内核：uv sync --extra render-local && uv run playwright install chromium
BROWSERLESS_MODE=REMOTE
# 用户信息卡自动主题：北京时间 07:00（含）至 19:00（不含）浅色，其余深色。
# 默认开启；设为 false 时完全跟随被查询账户的 is_dark_mode，不修改账户偏好。
USER_CARD_AUTO_THEME=true
# 云控配置服务（JSON；用于自动放人 / 临时入群欢迎语）
API_CLOUDCONFIG={"endpoint": "https://cloudconfig.example.com", "username": "user", "password": "pass"}

# ==== 失败重试 ====
# 外部网络服务请求失败后的重试次数（首次失败后重试；=2 即合计最多 3 次请求，=0 表示不重试）
# 生效范围：&ygg / &pro / &user / &uid 的外部服务调用（渲染类服务不参与重试）
FAILED_RETRY_TIME=2

# ==== 数据库 ====
DB_MONGO__URL=mongodb://127.0.0.1:27017

# ==== 权限与密钥 ====
# 管理员 QQ 号列表已迁移至 config.yml（复制 config.yml.example 为 config.yml）
# LittleSkin Admin API Token（用于查询用户 UID / 邮箱）
LITTLESKIN_ADMIN_TOKEN=eyJhbGciOi...

# 飞书自建应用凭证（用于 &banlog 写入多维表格封禁记录）
# 获取方式：https://open.feishu.cn/app → 创建企业自建应用 → 凭证与基础信息
# 需要开通权限 bitable:app（查看、评论、编辑和管理多维表格）；
# 还需开启机器人能力并发布版本，否则无法在多维表格「添加文档应用」中被搜到。
API_FEISHU__APP_ID=cli_xxxxxxxxxxxxxxxx
API_FEISHU__APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==== 飞书多维表格封禁记录（&banlog 写入目标）====
# 表格链接形如 https://xxx.feishu.cn/base/<app_token>?table=<table_id>
#   APP_TOKEN = base/ 后面那段
#   TABLE_ID  = table= 后面那段
# 若表格在知识库中（链接含 /wiki/），需先用 wiki 接口换取真实 app_token。
# 前置条件（缺一不可）：
#   1. 上方 API_FEISHU__APP_ID / API_FEISHU__APP_SECRET 已填写
#   2. 应用已开通 bitable:app 权限
#   3. 在多维表格 ⋯ → 更多 → 添加文档应用 中把应用加为「可编辑」协作者
FEISHU_BAN__APP_TOKEN=bascnxxxxxxxxxxxxxxxxxxxxxx
FEISHU_BAN__TABLE_ID=tblxxxxxxxxxxxxxx
# 各逻辑字段对应的表格列名。留空则按内置别名自动探测；
# 自动探测结果可用 &banlog.fields 命令查看。
FEISHU_BAN__FIELDS__UID=UID
FEISHU_BAN__FIELDS__CATEGORY=类别
FEISHU_BAN__FIELDS__NOTE=备注
FEISHU_BAN__FIELDS__AUTO_OPERATOR=自动化处理人员

# ==== 简易问答内容 ====
# 静态问答（&help / &faq / &pay ...）的回复内容 JSON 文件路径
# 默认位于项目根目录的 commspt_simple_response.json
# COMMSPT_SIMPLE_RESPONSE_FILE=./commspt_simple_response.json

# ==== 插件静态资源 ====
# 插件静态资源（字体、图片等）目录路径，默认位于项目根目录的 assets/，可用此环境变量覆盖
# COMMSPT_ASSETS_DIR=./assets
