# commspt-bot 应用配置示例
# config.yml 默认从项目根目录读取，也可通过环境变量 COMMSPT_CONFIG_FILE 指定路径。
# 注：飞书多维表格相关配置已迁至 .env，见 FEISHU_BAN__* 环境变量。

# 管理员 QQ 号列表（可执行 %mute / %check / do 等管理员命令）
admin_list:
  - 123
  - 456

# 请求日志：把项目对外部服务（HTTP / MongoDB / SDK）请求的失败按天追加写入文本文件，
# 仅用于排障，不影响业务；详见 README「请求日志」小节。
request_logging:
  # 是否启用。设为 false 时不创建日志目录、不写任何文件。
  enabled: true
  # 日志目录。相对路径按项目根目录解析，也可填写绝对路径。
  # 每日子文件名为 YYYY-MM-DD.log（Asia/Shanghai），只追加、不轮转。
  directory: ./logs/commspt-bot/
