<!DOCTYPE html>
<html lang="zh-CN" data-theme="{{ 'dark' if is_dark_mode else 'light' }}">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>入群申请转人工：答案不是纯数字</title>
    {# 资源基址由渲染后端注入，见 browserless.py 的 _resolve_assets() #}
    {% if assets_origin %}
    <link rel="preconnect" href="{{ assets_origin }}" />
    {% endif %}
    {# 与用户信息卡共用同一套样式，版式说明见 card-base.css.jinja #}
    <style>{% include "card-base.css.jinja" %}</style>
</head>
<body{% if transparent %} class="no-chrome"{% endif %}>
    {#- Bot 只在条件满足时自动同意；答案不是纯数字就转人工。卡片只摆事实（申请人的原话、
        QQ 资料），不推断、不给处理建议，由管理员判断（例如对方可能无法注册）。 -#}
    {% set sex_label = {'male': '男', 'female': '女'} %}
    {% set profile = [] %}
    {% if qq_level %}{% set _ = profile.append('Lv.' ~ qq_level) %}{% endif %}
    {% if qq_sex in sex_label %}{% set _ = profile.append(sex_label[qq_sex]) %}{% endif %}
    {% if qq_age %}{% set _ = profile.append(qq_age ~ ' 岁') %}{% endif %}
    <article class="card is-wait" aria-label="入群申请转人工">
        <header class="band">
            <p class="meta">
                <span class="chip wait">转人工</span>
                <span>答案不是纯数字</span>
                <span class="end"><b>{{ '主群' if kind == 'Main' else '茶馆' }}</b><span>{{ '邀请入群' if sub_type == 'invite' else '主动申请' }}</span></span>
            </p>
            {% if answer | trim %}
            <h1 class="title">{{ answer | trim }}</h1>
            {% else %}
            <h1 class="title is-empty">（未填写答案）</h1>
            {% endif %}
        </header>
        <dl class="rows">
            <div class="row">
                <dt>申请人</dt>
                <dd>{{ applicant }}<span class="sub">{{ qq_nickname or '昵称未获取' }}</span>
                    {%- if invited_id is not none %}<span class="note">也可能是 {{ invited_id }}</span>{% endif %}</dd>
            </div>
            {% if profile %}
            <div class="row"><dt>QQ 资料</dt><dd>{{ profile | join('　') }}</dd></div>
            {% endif %}
            {% if qq_registered_ago %}
            <div class="row"><dt>QQ 注册</dt><dd>{{ qq_registered_ago }}<span class="sub">{{ qq_registered_on }}</span></dd></div>
            {% endif %}
            {% if qq_sign %}
            <div class="row"><dt>个性签名</dt><dd class="clamp">{{ qq_sign }}</dd></div>
            {% endif %}
        </dl>
        <p class="foot">生成于 {{ generated_at }}</p>
    </article>
</body>
</html>
