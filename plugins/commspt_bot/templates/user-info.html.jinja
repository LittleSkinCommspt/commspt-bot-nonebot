<!DOCTYPE html>
<html lang="zh-CN" data-theme="{{ 'dark' if is_dark_mode else 'light' }}">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LittleSkin 用户档案</title>
    {# 资源基址由渲染后端注入，见 browserless.py 的 _resolve_assets() #}
    {% if assets_origin %}
    <link rel="preconnect" href="{{ assets_origin }}" />
    {% endif %}
    {# 与「答案不是纯数字」提示卡共用同一套样式，版式说明见 card-base.css.jinja #}
    <style>{% include "card-base.css.jinja" %}</style>
</head>
<body{% if transparent %} class="no-chrome"{% endif %}>
    {% set banned = permission == -1 %}
    {% macro when(ago, at) -%}
    {{ ago }}<span class="sub">{{ at }}</span>
    {%- endmacro %}
    <article class="card {{ 'is-bad' if banned else 'is-ok' }}" aria-label="LittleSkin 用户档案">
        <header class="band">
            <p class="meta">
                <span class="chip {{ 'bad' if banned else 'ok' }}">{{ '已封禁' if banned else '正常' }}</span>
                <span>UID <b>{{ uid }}</b></span>
                <span>积分 <b>{{ '{:,}'.format(score) }}</b></span>
            </p>
            <h1 class="title">{{ nickname }}</h1>
        </header>
        <dl class="rows">
            {% if banned %}
            <div class="row is-bad"><dt>封禁原因</dt><dd class="pre">{{ (ban_reason or '') | trim or '未提供封禁原因' }}</dd></div>
            {% endif %}
            <div class="row">
                <dt>邮箱</dt>
                <dd>{{ email }}<span class="tag {{ 'ok' if verified else 'wait' }}">{{ '已验证' if verified else '未验证' }}</span>
                    {%- if email | lower != email %}<span class="note warn">邮箱含有大写字母</span>{% endif %}</dd>
            </div>
            {% if qq %}
            <div class="row">
                <dt>绑定 QQ</dt>
                <dd>{{ qq }}<span class="sub">{{ qq_nickname or '昵称未获取' }}</span>
                    {%- if qq ~ '@qq.com' == email %}<span class="tag ok">与邮箱一致</span>{% endif %}</dd>
            </div>
            {% endif %}
            <div class="row"><dt>注册属地</dt><dd{% if not network %} class="quiet"{% endif %}>{{ network or '未获取' }}</dd></div>
            <div class="row"><dt>注册</dt><dd>{{ when(register_ago, register_at) }}</dd></div>
            <div class="row">
                <dt>最后签到</dt>
                {% if register_at > last_sign_at %}
                <dd class="quiet">从未签到过</dd>
                {% else %}
                <dd>{{ when(last_sign_ago, last_sign_at) }}</dd>
                {% endif %}
            </div>
        </dl>
        <p class="foot">生成于 {{ generated_at }}</p>
    </article>
</body>
</html>
