<!DOCTYPE html>
<html lang="zh-CN" data-theme="{{ 'dark' if is_dark_mode else 'light' }}">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LittleSkin 用户档案</title>
    <style>
        :root {
            color-scheme: light;
            --surface: #fcfdfc;
            --ink: #1d2c27;
            --muted: #52665c;
            --line: #dce6df;
            --soft: #f1f6f2;
            --green: #246944;
            --green-bg: #e8f3eb;
            --red: #aa3329;
            --red-bg: #fff0ed;
            --red-line: #e7b2a9;
            --amber: #805012;
            --amber-bg: #fff0d9;
        }
        :root[data-theme="dark"] {
            color-scheme: dark;
            --surface: #171f1d;
            --ink: #ecf4ef;
            --muted: #b5c5bc;
            --line: #394a41;
            --soft: #26362d;
            --green: #a0d9ad;
            --green-bg: #263e2f;
            --red: #ffc0b6;
            --red-bg: #432829;
            --red-line: #87504d;
            --amber: #f9d39b;
            --amber-bg: #4b3821;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 0;
            background: var(--soft);
            color: var(--ink);
            font: 400 16px/1.65 "Noto Sans CJK SC", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
        }
        h1, h2, p, dl, dd { margin: 0; }
        .mono {
            font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
            font-variant-numeric: tabular-nums;
            overflow-wrap: anywhere;
        }
        .timestamp { display: block; }
        .timestamp span { display: block; }
        .record {
            width: 100%;
            max-width: 530px;
            margin: 0 auto;
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 20px;
            overflow: hidden;
        }
        .record.is-banned { border-color: var(--red-line); border-top: 4px solid var(--red); }
        .header {
            padding: 22px 26px 18px;
            border-bottom: 1px solid var(--line);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
        }
        .brand { font-size: 15px; font-weight: 600; letter-spacing: -.3px; }
        .brand small { display: block; font-size: 11px; font-weight: 400; letter-spacing: .7px; color: var(--muted); }
        .query-label { color: var(--muted); font-size: 12px; }
        .identity { padding: 26px 26px 22px; }
        .identity-line { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; }
        .identity-copy { min-width: 0; flex: 1; }
        h1 { font-size: 27px; line-height: 1.35; font-weight: 600; overflow-wrap: anywhere; }
        .uid { margin-top: 7px; font-size: 14px; color: var(--muted); }
        .account-state { flex-shrink: 0; text-align: right; }
        .state-label { display: block; margin-bottom: 6px; font-size: 11px; color: var(--muted); }
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 6px;
            background: var(--green-bg);
            color: var(--green);
            font-size: 12px;
            font-weight: 500;
            white-space: nowrap;
        }
        .badge::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
        .is-banned .account-badge { background: var(--red-bg); color: var(--red); }
        .ban-notice {
            margin-top: 20px;
            padding: 16px 18px;
            border-left: 4px solid var(--red);
            border-radius: 10px;
            background: var(--red-bg);
            color: var(--red);
        }
        .ban-heading { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; }
        .ban-icon { flex: none; width: 18px; height: 18px; }
        .ban-label { display: block; margin: 8px 0 4px; font-size: 12px; }
        .ban-reason { font-size: 14px; white-space: pre-wrap; overflow-wrap: anywhere; }
        .details { padding: 0 26px 24px; }
        .email { padding: 16px 18px; border-radius: 12px; background: var(--soft); }
        .email-heading { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 7px; }
        .email-heading h2 { font-size: 14px; font-weight: 500; }
        .email-value { font-size: 18px; overflow-wrap: anywhere; }
        .email.is-unverified .badge { background: var(--amber-bg); color: var(--amber); }
        .email-help { margin-top: 6px; font-size: 12px; color: var(--amber); overflow-wrap: anywhere; }
        .qq-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; margin-top: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
        .qq-note { margin-top: 4px; font-size: 11px; color: var(--green); }
        .account-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px 16px; margin-top: 20px; }
        .qq-grid > div, .account-grid > div { min-width: 0; }
        dt { font-size: 12px; color: var(--muted); }
        dd { margin-top: 4px; font-size: 15px; font-weight: 500; overflow-wrap: anywhere; }
        .footer { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; padding: 14px 26px; border-top: 1px solid var(--line); background: var(--soft); color: var(--muted); font-size: 11px; }
        @media (max-width: 440px) {
            .header, .identity { padding: 20px; }
            .details { padding: 0 20px 20px; }
            h1 { font-size: 23px; }
            .footer { padding: 14px 20px; }
        }
        @media (max-width: 350px) {
            .account-grid { grid-template-columns: 1fr; }
            .email-value { font-size: 16px; }
        }
    </style>
</head>
<body>
    {% macro timestamp(value) -%}
    {% set parts = value.split(' ', 1) %}
    <time class="timestamp mono" datetime="{{ value | replace(' ', 'T') }}"><span>{{ parts[0] }}</span>{% if parts | length > 1 %}<span class="clock">{{ parts[1] }}</span>{% endif %}</time>
    {%- endmacro %}
    {% set banned = permission == -1 %}
    <article class="record{% if banned %} is-banned{% endif %}" aria-label="LittleSkin 用户档案">
        <header class="header">
            <div class="brand">LittleSkin<small>COMMUNITY SUPPORT</small></div>
            <p class="query-label">内部用户查询</p>
        </header>
        <section class="identity">
            <div class="identity-line">
                <div class="identity-copy"><h1>{{ nickname }}</h1><p class="uid mono">UID {{ uid }}</p></div>
                <div class="account-state"><span class="state-label">账户状态</span><span class="badge account-badge">{{ '已封禁' if banned else '正常' }}</span></div>
            </div>
            {% if banned %}
            <section class="ban-notice" aria-label="账户封禁提醒">
                <h2 class="ban-heading"><svg class="ban-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 7v6c0 4 4 7 8 9 4-2 8-5 8-9V7Z"/><path d="M12 8v5"/><circle cx="12" cy="17" r=".75" fill="currentColor" stroke="none"/></svg>账户已封禁</h2>
                <span class="ban-label">封禁原因</span>
                <p class="ban-reason">{{ (ban_reason or '') | trim or '未提供封禁原因' }}</p>
            </section>
            {% endif %}
        </section>
        <div class="details">
            <section class="email{% if not verified %} is-unverified{% endif %}" aria-label="邮箱信息">
                <div class="email-heading"><h2>邮箱</h2><span class="badge">{{ '已验证' if verified else '未验证' }}</span></div>
                <p class="email-value mono">{{ email }}</p>
                {% if email | lower != email %}<p class="email-help">{{ email_help }}</p>{% endif %}
            </section>
            {% if qq %}
            <dl class="qq-grid">
                <div><dt>绑定 QQ</dt><dd class="mono">{{ qq }}</dd>{% if qq ~ '@qq.com' == email %}<p class="qq-note">与账号邮箱一致</p>{% endif %}</div>
                <div><dt>QQ 昵称</dt><dd>{{ qq_nickname or '未获取' }}</dd></div>
            </dl>
            {% endif %}
            <dl class="account-grid">
                <div><dt>积分</dt><dd class="mono">{{ '{:,}'.format(score) }}</dd></div>
                <div><dt>注册 IP 属地</dt><dd>{{ network or '未获取' }}</dd></div>
                <div><dt>注册时间</dt><dd>{{ timestamp(register_at) }}</dd></div>
                <div><dt>最后签到</dt><dd>{% if register_at > last_sign_at %}从未签到过{% else %}{{ timestamp(last_sign_at) }}{% endif %}</dd></div>
            </dl>
        </div>
        <footer class="footer"><span>内部支持 · 用户档案</span><span>生成于 <time class="mono">{{ generated_at }}</time></span></footer>
    </article>
</body>
</html>
